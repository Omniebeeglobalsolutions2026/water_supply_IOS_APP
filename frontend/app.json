{
  "expo": {
    "name": "Bhagira",
    "slug": "waterflow-supply",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.waterflowsupply"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#176bb1",
          "defaultChannel": "orders",
          "sounds": [
            "./assets/order_alert.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bhagira to select your government ID and bank passbook images for vendor verification."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Bhagira to show your current location for water delivery."
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "363c5d28-dd2a-434b-996c-70b89147e893"
      }
    }
  }
}
